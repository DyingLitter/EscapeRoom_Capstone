  dialogueLines:
  - speaker: 1
    text: 'It''s my parent''s room. '
    endAction: 
  - speaker: 1
    text: Might not be the brightest idea to unlock it
    endAction: 
  - speaker: 1
    text: If mom comes out that's fine but if dad came out then I fear
    endAction: 
  - speaker: 1
    text: I may not see tomorrow
